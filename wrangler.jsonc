{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hakan-run-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist/apps/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets are served before the Worker by default, and a top-level
    // navigation that matches no file receives index.html without the Worker
    // ever running. That made /boss render the public 404 shell and
    // /api/boss/* return HTML instead of JSON, with Worker-side Access
    // verification never executing. Listing these routes runs the Worker
    // first for them; every other path keeps the default asset-first
    // behaviour, so static delivery is unchanged.
    "run_worker_first": ["/api/*", "/boss", "/boss/*"]
  },
  "observability": { "enabled": true },

  // Production is live. Provider mutations still require their own explicit
  // authorization, and the source-controlled contract must preserve its domain.
  "env": {
    "staging": {
      "name": "hakan-run-web-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ANALYTICS_ENABLED": "true",
        "NOTIFICATIONS_ENABLED": "false",
        "NOTIFICATION_SENDER": "noreply@hakan.run",
        "NOTIFICATION_RECIPIENT": "hakan@dndr.net",
        "ACCESS_TEAM_DOMAIN": "dndrnet.cloudflareaccess.com",
        // Audience tag of the staging Access application hakan-run-boss-staging.
        // Read back from the provider after the application was created, never
        // predicted. Non-secret: it identifies which application a token was
        // issued for, and the Worker still verifies the signature against the
        // team key set before trusting the claim.
        "ACCESS_AUD_BOSS": "c9f9d4070414d021c4aad110bc37f11d45795951902147b555abc89742e02e1e",
        "BOSS_OWNER_EMAIL": "hakan@dndr.net",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEm_dH-JFfwoJxQ0"
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "hakan-run-app-staging",
          "database_id": "71a28b10-861f-4554-9e14-5464c7116394",
          "migrations_dir": "migrations/app"
        },
        {
          "binding": "ANALYTICS_DB",
          "database_name": "hakan-run-analytics-staging",
          "database_id": "4998c398-4f42-4472-a008-24e737359a03",
          "migrations_dir": "migrations/analytics"
        }
      ],
      "triggers": { "crons": ["30 8 * * *"] },
      // The staging hostname is declared here so it is created by the first
      // deployment rather than by hand. workers.dev stays off: staging is not a
      // public surface and must not be reachable on a second origin.
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.hakan.run", "custom_domain": true }
      ]
    },
    "production": {
      "name": "hakan-run-web-production",
      "vars": {
        "ENVIRONMENT": "production",
        "CMS_PRODUCTION_WRITES_ENABLED": "false",
        "ANALYTICS_ENABLED": "true",
        "NOTIFICATIONS_ENABLED": "false",
        "BOSS_OWNER_EMAIL": "hakan@dndr.net",
        // Account team domain and production application audience were read back
        // from Cloudflare after the isolated Access application was created.
        "ACCESS_TEAM_DOMAIN": "dndrnet.cloudflareaccess.com",
        "ACCESS_AUD_BOSS": "a4c69082066aab12ecfa785868e05664994787c61063df51d346f5729eb89d71",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEuX8mAZVNXXGL29"
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "hakan-run-app-production",
          "database_id": "1b9504fb-7d3d-4435-aba7-46b41126ebb5",
          "migrations_dir": "migrations/app"
        },
        {
          "binding": "ANALYTICS_DB",
          "database_name": "hakan-run-analytics-production",
          "database_id": "a8f42365-dff2-4098-8eeb-785a34ed4a3b",
          "migrations_dir": "migrations/analytics"
        }
      ],
      "triggers": { "crons": [] },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "hakan.run", "custom_domain": true }
      ]
    }
  }
}
