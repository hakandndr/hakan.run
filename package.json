{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "concurrently --kill-others --raw",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "test": "playwright test",
    "test:worker": "node --test \"worker/tests/*.test.js\"",
    "test:web": "node --test \"apps/web/tools/*.test.js\" \"apps/web/src/boss/*.test.js\" \"apps/web/src/head/*.test.js\" \"apps/web/src/content-source/*.test.js\"",
    "test:tools": "node --test \"tools/*.test.js\"",
    "check": "npm run lint && npm run test:worker && npm run test:web && npm run test:tools"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
